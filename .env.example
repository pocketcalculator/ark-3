# ark-3 environment variables
# Copy to .env and fill in real values — NEVER commit .env

# ── Azure Subscription ──────────────────────────────────────────────────────
ARK3_AZURE_SUBSCRIPTION_ID=<your-subscription-id>
ARK3_AZURE_SUBSCRIPTION_DISPLAY_LABEL=<e.g. My Dev Sub>
AZURE_TENANT_ID=<your-tenant-id>

# ── Resource group deletion allowlist ────────────────────────────────────────
# Comma-separated list of RG names permitted for deletion (exact match, case-insensitive)
ARK3_RG_ALLOWLIST=<rg-sandbox-disposable>

# ── Vision Model ─────────────────────────────────────────────────────────────
# Azure OpenAI / AI Services endpoint
ARK3_OPENAI_ENDPOINT=<https://your-resource.openai.azure.com/>
# Model deployment name (created in Azure OpenAI studio)
ARK3_OPENAI_DEPLOYMENT_NAME=<ark3-vision>
# Azure OpenAI REST API version
ARK3_OPENAI_API_VERSION=2026-03-17

# ── Storage ───────────────────────────────────────────────────────────────────
ARK3_STORAGE_ACCOUNT_NAME=<storage-account-name>
# Blob provider: azure (production) | azurite (local) | memory (test)
ARK3_BLOB_STORAGE_PROVIDER=azure

# ── Table Storage ─────────────────────────────────────────────────────────────
ARK3_STORAGE_TABLE_NAME=approvals

# ── Key Vault ─────────────────────────────────────────────────────────────────
ARK3_KEYVAULT_URL=<https://your-keyvault.vault.azure.net/>
ARK3_DEVICE_TOKEN_SECRET_NAME=device-token-verifier

# ── CORS / Same-origin ────────────────────────────────────────────────────────
ARK3_CORS_ORIGIN=<https://your-container-app-fqdn>

# ── App / Server ─────────────────────────────────────────────────────────────
PORT=3000
NODE_ENV=development

# ── Auth bypass (development ONLY — never enable in production) ───────────────
ARK3_AUTH_BYPASS=false

# ── Azurite (local only) ──────────────────────────────────────────────────────
# AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devaccount1;AccountKey=devkey1;BlobEndpoint=http://localhost:10000/devaccount1;TableEndpoint=http://localhost:10002/devaccount1;
