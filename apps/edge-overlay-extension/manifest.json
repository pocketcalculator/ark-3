{
  "manifest_version": 3,
  "name": "ARK-3 GIF Overlay",
  "version": "1.0.0",
  "description": "Shows a user-selected animated GIF in a full-viewport overlay on the current tab.",
  "permissions": [
    "activeTab",
    "scripting",
    "storage"
  ],
  "action": {
    "default_title": "GIF Overlay",
    "default_popup": "popup.html"
  },
  "web_accessible_resources": [
    {
      "resources": [
        "assets/*.gif"
      ],
      "matches": [
        "<all_urls>"
      ]
    }
  ]
}
