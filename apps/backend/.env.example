# ark-3 backend environment (copy to .env — NEVER commit real secrets)

# ── Runtime ──────────────────────────────────────────────────────────────────
NODE_ENV=development
PORT=3000

# ── Auth ─────────────────────────────────────────────────────────────────────
# Only permitted when NODE_ENV=development and no managed identity is present.
ARK3_AUTH_BYPASS=true
ARK3_APPROVER_ROLE=approver
ARK3_CORS_ORIGIN=http://localhost:3000

# ── Azure subscription ───────────────────────────────────────────────────────
ARK3_AZURE_SUBSCRIPTION_ID=00000000-0000-0000-0000-000000000000
ARK3_AZURE_SUBSCRIPTION_DISPLAY_LABEL=Local Dev

# ── Deletion allowlist / caps ────────────────────────────────────────────────
ARK3_RG_ALLOWLIST=rg-test-disposable
ARK3_DAILY_DELETION_CAP=10
ARK3_DEVICE_RATE_LIMIT_RPM=10

# ── Azure OpenAI (vision) ────────────────────────────────────────────────────
ARK3_OPENAI_ENDPOINT=http://localhost:8080
ARK3_OPENAI_DEPLOYMENT_NAME=mock-vision
ARK3_OPENAI_API_VERSION=2026-03-17

# ── Storage ──────────────────────────────────────────────────────────────────
ARK3_STORAGE_ACCOUNT_NAME=devaccount1
ARK3_STORAGE_TABLE_NAME=approvals
ARK3_BLOB_STORAGE_PROVIDER=azurite
AZURITE_CONNECTION_STRING=DefaultEndpointsProtocol=http;AccountName=devaccount1;AccountKey=devkey1;BlobEndpoint=http://localhost:10000/devaccount1;TableEndpoint=http://localhost:10002/devaccount1;

# ── Key Vault / device token ─────────────────────────────────────────────────
ARK3_KEYVAULT_URL=https://example.vault.azure.net/
ARK3_DEVICE_TOKEN_SECRET_NAME=ark3-device-token-hash
# In dev the token hash is read from this env var (EnvSecretProvider).
ark3-device-token-hash=
