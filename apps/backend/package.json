{
  "name": "@ark-3/backend",
  "version": "0.0.0",
  "private": true,
  "description": "ark-3 Fastify backend — OCR upload, approval, Azure RG deletion",
  "type": "module",
  "scripts": {
    "build": "tsup src/index.ts --format esm --out-dir dist --sourcemap",
    "typecheck": "tsc --noEmit",
    "lint": "eslint src test",
    "test": "vitest run",
    "test:coverage": "vitest run --coverage",
    "start": "node dist/index.js",
    "dev": "tsx watch src/index.ts"
  },
  "dependencies": {
    "@ark-3/contracts": "*",
    "@azure/arm-resources": "^6.0.0",
    "@azure/data-tables": "^13.0.0",
    "@azure/identity": "^4.0.0",
    "@azure/keyvault-secrets": "^4.0.0",
    "@azure/storage-blob": "^12.0.0",
    "@fastify/multipart": "^9.0.0",
    "@fastify/static": "^10.1.3",
    "fastify": "^5.0.0",
    "openai": "^4.0.0",
    "pino": "^9.0.0",
    "zod": "^3.23.0"
  },
  "devDependencies": {
    "@types/node": "^26.0.0",
    "@vitest/coverage-v8": "^4.1.10",
    "tsup": "^8.0.0",
    "tsx": "^4.0.0",
    "typescript": "^5.5.0",
    "typescript-eslint": "^8.0.0",
    "vitest": "^4.1.10"
  }
}
