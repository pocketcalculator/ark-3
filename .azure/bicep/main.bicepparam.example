// main.bicepparam.example — Example parameter file for ark-3 Bicep deployment.
//
// ⚠️ DO NOT commit a file containing real identifiers to source control.
//    Copy this file to main.bicepparam (git-ignored), fill in real values,
//    and supply it at deploy time:
//
//      az deployment sub create \
//        --location canadacentral \
//        --template-file .azure/bicep/main.bicep \
//        --parameters .azure/bicep/main.bicepparam
//
// ── What-if (dry-run, no mutation) ───────────────────────────────────────────
//      az deployment sub what-if \
//        --location canadacentral \
//        --template-file .azure/bicep/main.bicep \
//        --parameters .azure/bicep/main.bicepparam
//
// ── Validation commands ───────────────────────────────────────────────────────
//      az bicep build --file .azure/bicep/main.bicep
//      az bicep lint  --file .azure/bicep/main.bicep

using './main.bicep'

// ── Required: short unique suffix (3–8 lowercase alphanumeric) ────────────────
// Generate with: az group list --query "[0].id" -o tsv | md5sum | cut -c1-8
// Or choose a memorable short value unique to your subscription, e.g. 'a1b2c3d4'
param suffix = '<3-to-8-char-alphanumeric-suffix>'

// ── Required: deployment region ───────────────────────────────────────────────
param location = 'canadacentral'

// ── Required: Azure subscription ID ─────────────────────────────────────────
// Never commit your real subscription ID. Supply at deploy time.
param subscriptionId = '<AZURE_SUBSCRIPTION_ID>'

// ── Required: Azure tenant ID ────────────────────────────────────────────────
// Never commit your real tenant ID. Supply at deploy time.
param tenantId = '<AZURE_TENANT_ID>'

// ── Optional: Easy Auth Entra app registration client ID ─────────────────────
// Leave empty until you have completed the app registration (see post-deploy checklist).
// After registration, re-deploy with the real client ID:
//   param easyAuthClientId = '<YOUR-ENTRA-APP-CLIENT-ID>'
param easyAuthClientId = ''

// ── Optional: bootstrap container image ──────────────────────────────────────
// Default public image used until the real app image is built and pushed to ACR.
// Override only if you have a specific bootstrap image to use.
param containerImage = 'mcr.microsoft.com/k8se/quickstart:latest'

// ── Optional: Azure OpenAI model configuration ───────────────────────────────
// Verify model availability in canadacentral before deploying:
//   az cognitiveservices model list --location canadacentral -o table | grep gpt
//
// ⚠️  modelVersion must be a currently-supported version — verify before deploying:
//   https://learn.microsoft.com/azure/ai-services/openai/concepts/models

param modelName = 'gpt-5.4-mini'
param modelVersion = '2026-03-17'
param modelSkuName = 'GlobalStandard'
param modelCapacity = 10

// ── Required: app configuration (injected as Container App env vars) ─────────

// Subscription display label shown in the approval UI
param subscriptionDisplayLabel = '<e.g. My Dev Sub>'

// Comma-separated list of resource group names allowed for deletion (exact names, case-insensitive)
param rgAllowlist = '<rg-sandbox-disposable>'

// CORS origin — must match the Container App public URL.
// On first deploy, leave empty. After deployment, update to:
//   https://<containerAppFqdn output>
param corsOrigin = ''

// Azure OpenAI API version (must match the deployed model's supported API versions)
param openaiApiVersion = '2026-03-17'
